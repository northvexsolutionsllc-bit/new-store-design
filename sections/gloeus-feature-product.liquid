{%- comment -%}
  GLOEUS · Best-seller feature. Native Shopify add-to-cart via <product-form>
  (Dawn's global.js handles the AJAX add + cart drawer) — commerce logic untouched.
{%- endcomment -%}
{{ 'gloeus-tokens.css' | asset_url | stylesheet_tag }}

{%- assign p = section.settings.product -%}
{%- assign variant = p.selected_or_first_available_variant -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="g-container g-section gloeus-feature" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px;">
    <div class="gloeus-feature__grid">
      <div class="gloeus-feature__media g-reveal g-left g-cine">
        <div class="gloeus-feature__halo" aria-hidden="true"></div>
        {%- if p != blank and p.featured_image != blank -%}
          <img src="{{ p.featured_image | image_url: width: 1000 }}"
               srcset="{{ p.featured_image | image_url: width: 500 }} 500w, {{ p.featured_image | image_url: width: 1000 }} 1000w"
               sizes="(min-width:990px) 42vw, 84vw"
               width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}"
               alt="{{ p.featured_image.alt | escape | default: p.title | escape }}"
               loading="lazy" class="gloeus-feature__img">
        {%- else -%}
          <img src="{{ 'gloeus-product-hero.jpg' | asset_url }}" width="1024" height="1024" alt="{{ section.settings.heading | escape }}" loading="lazy" class="gloeus-feature__img">
        {%- endif -%}
      </div>

      <div class="gloeus-feature__copy g-reveal g-right">
        {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="g-h2">{{ section.settings.heading | default: p.title }}</h2>
        {%- if section.settings.text != blank -%}<p class="g-lead">{{ section.settings.text }}</p>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="gloeus-feature__chips">
            {%- for block in section.blocks -%}
              <li class="g-chip" {{ block.shopify_attributes }}>{{ block.settings.label }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if p != blank -%}
          <div class="gloeus-feature__buy">
            <div class="gloeus-feature__price g-price">
              {%- if variant.compare_at_price > variant.price -%}
                <span class="gloeus-feature__was">{{ variant.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="gloeus-feature__now">{{ variant.price | money }}</span>
              {%- if variant.compare_at_price > variant.price -%}
                {%- assign saved = variant.compare_at_price | minus: variant.price -%}
                <span class="gloeus-feature__save">Save {{ saved | money }}</span>
              {%- endif -%}
            </div>

            <product-form class="gloeus-feature__form">
              {%- form 'product', p, id: 'gloeus-feature-form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button type="submit" name="add" class="g-btn g-btn--rose g-magnetic"{% unless variant.available %} disabled{% endunless %}>
                  {%- if variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </button>
              {%- endform -%}
            </product-form>

            <a href="{{ p.url }}" class="gloeus-feature__link">View full details →</a>
          </div>
        {%- else -%}
          <p class="gloeus-feature__empty">Select a product in the theme editor to enable add-to-cart.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .g-section { padding-block: var(--pt) var(--pb); }
  #shopify-section-{{ section.id }} .gloeus-feature__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; grid-template-columns: 1fr; }
  #shopify-section-{{ section.id }} .gloeus-feature__media { position: relative; display: grid; place-items: center; }
  #shopify-section-{{ section.id }} .gloeus-feature__img { position: relative; z-index: 1; width: min(78%, 30rem); height: auto; border-radius: var(--g-radius-lg); box-shadow: var(--g-shadow); }
  #shopify-section-{{ section.id }} .gloeus-feature__halo { position: absolute; width: 92%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(242,167,188,0.5), transparent 65%); }
  #shopify-section-{{ section.id }} .gloeus-feature__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 1.4rem 0; }
  #shopify-section-{{ section.id }} .gloeus-feature__buy { margin-top: 1.4rem; display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  #shopify-section-{{ section.id }} .gloeus-feature__price { display: flex; align-items: baseline; gap: 0.7rem; }
  #shopify-section-{{ section.id }} .gloeus-feature__now { font-family: var(--font-heading-family); font-size: clamp(1.8rem, 4vw, 2.6rem); color: var(--g-rose-deep); }
  #shopify-section-{{ section.id }} .gloeus-feature__was { text-decoration: line-through; opacity: 0.5; }
  #shopify-section-{{ section.id }} .gloeus-feature__save { font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.7rem; border-radius: 999px; background: var(--g-petal-100); color: var(--g-rose-deep); }
  #shopify-section-{{ section.id }} .gloeus-feature__link { font-size: 0.9rem; opacity: 0.7; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 990px) { #shopify-section-{{ section.id }} .gloeus-feature__grid { grid-template-columns: 1fr 1fr; } }
</style>

{% schema %}
{
  "name": "Gloeus Feature Product",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✨ Best seller" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "OUHOE Hair Removal Spray" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our best-selling spray depilation — smooth, soft, confidently hair-free skin in minutes." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "chip", "name": "Benefit chip", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Pain-free" } ] }
  ],
  "max_blocks": 6,
  "presets": [ {
    "name": "Gloeus Feature Product",
    "blocks": [
      { "type": "chip", "settings": { "label": "Pain-free" } },
      { "type": "chip", "settings": { "label": "3–5 minute results" } },
      { "type": "chip", "settings": { "label": "All skin types" } },
      { "type": "chip", "settings": { "label": "120ml" } }
    ]
  } ]
}
{% endschema %}
