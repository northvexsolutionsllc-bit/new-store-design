{%- comment -%} GLOEUS · Limited-offer band — tasteful urgency, shimmer sweep on reveal. No fake countdowns. {%- endcomment -%}
{{ 'gloeus-tokens.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="g-container g-section gloeus-offer" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px;">
    <div class="gloeus-offer__card g-shimmer g-reveal g-scale">
      {%- if section.settings.eyebrow != blank -%}<p class="gloeus-offer__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="gloeus-offer__head">{{ section.settings.heading }}</h2>
      <div class="gloeus-offer__price g-price">
        {%- if section.settings.price != blank -%}<span class="gloeus-offer__now">{{ section.settings.price }}</span>{%- endif -%}
        {%- if section.settings.save != blank -%}<span class="gloeus-offer__save">{{ section.settings.save }}</span>{%- endif -%}
      </div>
      {%- if section.settings.subtext != blank -%}<p class="gloeus-offer__sub">{{ section.settings.subtext }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="g-btn g-btn--blush g-magnetic">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .g-section { padding-block: var(--pt) var(--pb); }
  #shopify-section-{{ section.id }} .gloeus-offer__card {
    text-align: center; border-radius: var(--g-radius-lg); padding: clamp(2.4rem, 6vw, 4.5rem) clamp(1.4rem, 5vw, 4rem);
    background: linear-gradient(135deg, var(--g-rose-deep), var(--g-blush));
    color: #fff; box-shadow: var(--g-shadow); display: grid; gap: 0.9rem; justify-items: center;
  }
  #shopify-section-{{ section.id }} .gloeus-offer__eyebrow { margin: 0; font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.9; }
  #shopify-section-{{ section.id }} .gloeus-offer__head { font-family: var(--font-heading-family); font-size: clamp(1.8rem, 5vw, 3.2rem); margin: 0; }
  #shopify-section-{{ section.id }} .gloeus-offer__price { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; justify-content: center; }
  #shopify-section-{{ section.id }} .gloeus-offer__now { font-family: var(--font-heading-family); font-size: clamp(2.4rem, 7vw, 4rem); }
  #shopify-section-{{ section.id }} .gloeus-offer__save { font-weight: 600; padding: 0.3rem 0.9rem; border-radius: 999px; background: rgba(255,255,255,0.22); }
  #shopify-section-{{ section.id }} .gloeus-offer__sub { margin: 0; opacity: 0.9; }
  #shopify-section-{{ section.id }} .gloeus-offer__card .g-btn { margin-top: 0.6rem; }
</style>

{% schema %}
{
  "name": "Gloeus Offer Band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "⏰ Limited time offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't miss out." },
    { "type": "text", "id": "price", "label": "Price", "default": "AED 39.99" },
    { "type": "text", "id": "save", "label": "Save badge", "default": "Save AED 25" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Free shipping across the UAE · Cash on delivery available" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Claim the offer" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Gloeus Offer Band" } ]
}
{% endschema %}
