{%- comment -%} GLOEUS · Benefits — staggered reveal cards, magnetic hover lift. {%- endcomment -%}
{{ 'gloeus-tokens.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="g-container g-section gloeus-benefits" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px;">
    <header class="gloeus-benefits__head">
      {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow g-reveal g-up">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="g-h2 g-reveal g-up" style="--g-i:1">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="g-lead g-reveal g-up" style="--g-i:2">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <div class="gloeus-benefits__grid">
      {%- for block in section.blocks -%}
        <article class="g-card gloeus-benefit g-reveal g-up g-magnetic" style="--g-i:{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="gloeus-benefit__icon" aria-hidden="true">{{ block.settings.icon }}</div>
          {%- endif -%}
          <h3 class="gloeus-benefit__title">{{ block.settings.title }}</h3>
          <p class="gloeus-benefit__text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .g-section { padding-block: var(--pt) var(--pb); }
  #shopify-section-{{ section.id }} .gloeus-benefits__head { max-width: 46rem; margin-bottom: clamp(2rem, 5vw, 3.4rem); }
  #shopify-section-{{ section.id }} .gloeus-benefits__head .g-h2 { margin: 0.3em 0 0.4em; }
  #shopify-section-{{ section.id }} .gloeus-benefits__grid {
    display: grid; gap: var(--g-gap);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  #shopify-section-{{ section.id }} .gloeus-benefit { display: flex; flex-direction: column; gap: 0.5rem; }
  #shopify-section-{{ section.id }} .gloeus-benefit__icon {
    width: 3rem; height: 3rem; display: grid; place-items: center; font-size: 1.5rem; margin-bottom: 0.4rem;
    border-radius: 50%; background: var(--g-petal-100); color: var(--g-rose-deep);
  }
  #shopify-section-{{ section.id }} .gloeus-benefit__title { font-family: var(--font-heading-family); font-size: var(--g-h3); margin: 0; }
  #shopify-section-{{ section.id }} .gloeus-benefit__text { margin: 0; opacity: 0.78; font-size: 0.98rem; }
</style>

{% schema %}
{
  "name": "Gloeus Benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why women love OUHOE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty that respects your skin." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Trusted by thousands of women across the UAE." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "✿" },
      { "type": "text", "id": "title", "label": "Title", "default": "Pain-Free Formula" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "No waxing, no razors, no pain. Just smooth skin." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ {
    "name": "Gloeus Benefits",
    "blocks": [
      { "type": "benefit", "settings": { "icon": "✿", "title": "Pain-Free Formula", "text": "No waxing, no razors, no pain. Just smooth skin." } },
      { "type": "benefit", "settings": { "icon": "✦", "title": "Fast Results", "text": "Visible results in just 3–5 minutes." } },
      { "type": "benefit", "settings": { "icon": "❀", "title": "Skin-Safe", "text": "Gentle formula safe for all skin types." } },
      { "type": "benefit", "settings": { "icon": "✧", "title": "Long-Lasting", "text": "Smooth skin for weeks, not days." } }
    ]
  } ]
}
{% endschema %}
