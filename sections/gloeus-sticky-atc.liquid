{%- comment -%}
  GLOEUS · Sticky mobile add-to-cart bar (safe-area-inset). Mobile only.
  The button clicks the REAL <product-form> submit in main-product — no commerce
  logic is duplicated or altered. Reveal is handled by gloeus-motion.js via the
  #gloeus-atc-anchor placed right below the product form.
{%- endcomment -%}
{{ 'gloeus-tokens.css' | asset_url | stylesheet_tag }}

{%- assign variant = product.selected_or_first_available_variant -%}

{%- comment -%} Anchor: when this scrolls above the viewport, the bar reveals. {%- endcomment -%}
<div id="gloeus-atc-anchor" aria-hidden="true" style="height:1px;"></div>

{%- if product != blank -%}
  <div class="g-sticky-atc" data-sticky-atc role="region" aria-label="{{ 'products.product.add_to_cart' | t }}">
    <div class="g-sticky-meta">
      <span class="g-sticky-title">{{ product.title }}</span>
      <span class="g-sticky-price">
        {%- if variant.compare_at_price > variant.price -%}
          <s style="opacity:.55;font-weight:400">{{ variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ variant.price | money }}
      </span>
    </div>
    <a href="{{ product.url }}" data-sticky-add class="g-btn g-btn--rose"{% unless variant.available %} aria-disabled="true"{% endunless %}>
      {%- if variant.available -%}{{ section.settings.button_label | default: 'Add to cart' }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Gloeus Sticky ATC",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Shows a mobile add-to-cart bar. Place directly under the Product information section. Clicks the real add-to-cart button — no logic is changed." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" }
  ],
  "presets": [ { "name": "Gloeus Sticky ATC" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
