{%- comment -%}
  GLOEUS · How It Works — scroll-scrubbed, pinned filmstrip (Apply → Wait → Wipe).
  Progress `--p` is driven in gloeus-motion.js from documentElement.clientHeight
  (Rule 4). Reduced-motion collapses the scrub (see gloeus-motion.css).
{%- endcomment -%}
{{ 'gloeus-tokens.css' | asset_url | stylesheet_tag }}

{%- assign steps = section.blocks.size | at_least: 1 -%}
{%- assign tx = steps | minus: 1 | times: 100.0 | divided_by: steps -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section
    id="gloeus-how"
    class="g-hiw"
    style="--steps:{{ steps }};--tx:{{ tx }}%;min-height:calc({{ steps }} * 100svh);min-height:calc({{ steps }} * 100vh);"
    aria-label="{{ section.settings.heading | escape }}"
  >
    <div class="g-hiw-sticky g-field">
      <div class="g-container gloeus-hiw__inner">
        <header class="gloeus-hiw__head">
          {%- if section.settings.eyebrow != blank -%}<p class="g-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="g-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        </header>

        <div class="g-hiw-track">
          {%- for block in section.blocks -%}
            <div class="g-hiw-panel gloeus-hiw__panel" {{ block.shopify_attributes }}>
              <div class="gloeus-hiw__panel-grid">
                <div class="gloeus-hiw__panel-copy">
                  <span class="g-step-num">{{ forloop.index0 | plus: 1 | prepend: '0' }}</span>
                  <h3 class="gloeus-hiw__panel-title">{{ block.settings.title }}</h3>
                  <p class="gloeus-hiw__panel-text">{{ block.settings.text }}</p>
                </div>
                <div class="gloeus-hiw__panel-media">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 900 }}"
                         srcset="{{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 900 }} 900w"
                         sizes="(min-width:990px) 40vw, 80vw"
                         width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                         alt="{{ block.settings.image.alt | escape | default: block.settings.title | escape }}"
                         loading="lazy" class="gloeus-hiw__img">
                  {%- else -%}
                    <div class="gloeus-hiw__placeholder" aria-hidden="true">{{ block.settings.glyph | default: '✿' }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <footer class="gloeus-hiw__foot">
          <div class="g-hiw-dots" aria-hidden="true">
            {%- for block in section.blocks -%}<span class="g-hiw-dot{% if forloop.first %} on{% endif %}"></span>{%- endfor -%}
          </div>
          <div class="g-hiw-progress" aria-hidden="true"><i></i></div>
        </footer>
      </div>
    </div>
  </section>
</div>

<style>
  #shopify-section-{{ section.id }} .gloeus-hiw__inner { width: 100%; display: grid; gap: clamp(1.5rem, 4vw, 2.6rem); }
  #shopify-section-{{ section.id }} .gloeus-hiw__head { text-align: center; }
  #shopify-section-{{ section.id }} .gloeus-hiw__head .g-h2 { margin: 0.3em 0 0; }
  #shopify-section-{{ section.id }} .gloeus-hiw__panel-grid {
    display: grid; gap: clamp(1.4rem, 4vw, 3rem); align-items: center; grid-template-columns: 1fr;
  }
  #shopify-section-{{ section.id }} .gloeus-hiw__panel-title { font-family: var(--font-heading-family); font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0.1em 0 0.3em; }
  #shopify-section-{{ section.id }} .gloeus-hiw__panel-text { font-size: var(--g-lead); opacity: 0.8; max-width: 40ch; margin: 0; }
  #shopify-section-{{ section.id }} .gloeus-hiw__img { width: 100%; height: auto; border-radius: var(--g-radius-lg); box-shadow: var(--g-shadow-soft); }
  #shopify-section-{{ section.id }} .gloeus-hiw__placeholder {
    aspect-ratio: 4 / 3; border-radius: var(--g-radius-lg); display: grid; place-items: center;
    font-size: clamp(3rem, 10vw, 6rem); color: var(--g-rose-deep);
    background: linear-gradient(135deg, var(--g-petal-50), var(--g-petal-100));
  }
  #shopify-section-{{ section.id }} .gloeus-hiw__foot { display: grid; gap: 0.9rem; justify-items: center; }
  #shopify-section-{{ section.id }} .g-hiw-progress { width: min(340px, 70%); }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .gloeus-hiw__panel-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

{% schema %}
{
  "name": "Gloeus How It Works",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Scrubs through each step as the visitor scrolls. Works best with 3 steps." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three minutes to smooth." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Apply" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Apply the spray evenly on the desired area." },
      { "type": "text", "id": "glyph", "label": "Fallback glyph", "default": "✿" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [ {
    "name": "Gloeus How It Works",
    "blocks": [
      { "type": "step", "settings": { "title": "Apply", "text": "Apply the spray evenly on the desired area.", "glyph": "✿" } },
      { "type": "step", "settings": { "title": "Wait 3–5 min", "text": "Let the formula work its magic.", "glyph": "✦" } },
      { "type": "step", "settings": { "title": "Wipe", "text": "Wipe away for smooth, hair-free skin.", "glyph": "❀" } }
    ]
  } ]
}
{% endschema %}
