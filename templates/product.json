{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "sticky_atc": {
      "type": "gloeus-sticky-atc",
      "settings": {
        "button_label": "Add to cart"
      }
    },
    "product_benefits": {
      "type": "gloeus-benefits",
      "blocks": {
        "b1": { "type": "benefit", "settings": { "icon": "✿", "title": "Pain-Free Formula", "text": "No waxing, no razors, no pain. Just smooth skin." } },
        "b2": { "type": "benefit", "settings": { "icon": "✦", "title": "Fast Results", "text": "Visible results in just 3–5 minutes." } },
        "b3": { "type": "benefit", "settings": { "icon": "❀", "title": "Skin-Safe", "text": "Gentle formula safe for all skin types." } },
        "b4": { "type": "benefit", "settings": { "icon": "✧", "title": "Long-Lasting", "text": "Smooth skin for weeks, not days." } }
      },
      "block_order": ["b1", "b2", "b3", "b4"],
      "settings": {
        "eyebrow": "Why women love OUHOE",
        "heading": "Every reason to switch.",
        "subheading": "Trusted by thousands of women across the UAE.",
        "color_scheme": "scheme-2",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "product_testimonials": {
      "type": "gloeus-testimonials",
      "blocks": {
        "t1": { "type": "quote", "settings": { "quote": "This spray is a game changer! No more painful waxing sessions. My skin feels so smooth and it lasts for weeks!", "name": "Sarah M.", "city": "Dubai" } },
        "t2": { "type": "quote", "settings": { "quote": "I was skeptical at first, but this product really works! It's gentle on my sensitive skin and the results are amazing.", "name": "Fatima A.", "city": "Abu Dhabi" } },
        "t3": { "type": "quote", "settings": { "quote": "Best purchase ever! Quick delivery, easy to use, and the results speak for themselves. Highly recommend!", "name": "Layla K.", "city": "Sharjah" } }
      },
      "block_order": ["t1", "t2", "t3"],
      "settings": {
        "eyebrow": "What our customers say",
        "heading": "Loved across the Emirates.",
        "speed": 40,
        "color_scheme": "scheme-1",
        "padding_top": 56,
        "padding_bottom": 56
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "sticky_atc",
    "product_benefits",
    "product_testimonials",
    "disclosures",
    "related-products"
  ]
}
