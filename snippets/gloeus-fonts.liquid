{%- comment -%}
  Gloeus self-hosted display + body faces (Fraunces / Jost).
  Rendered through Liquid so asset_url keeps Shopify's fingerprinting/caching.
  All faces use font-display: swap so the entrance gate is never blocked on fonts.
{%- endcomment -%}
{% style %}
  @font-face {
    font-family: "Fraunces";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'gloeus-fraunces-400.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Fraunces";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'gloeus-fraunces-400-italic.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Fraunces";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url({{ 'gloeus-fraunces-600.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Fraunces";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url({{ 'gloeus-fraunces-700.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'gloeus-jost-400.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url({{ 'gloeus-jost-500.woff2' | asset_url }}) format("woff2");
  }
  @font-face {
    font-family: "Jost";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url({{ 'gloeus-jost-600.woff2' | asset_url }}) format("woff2");
  }
{% endstyle %}
{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" as="font" href="{{ 'gloeus-jost-400.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'gloeus-fraunces-600.woff2' | asset_url }}" type="font/woff2" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}
